# E2E credentials. Never commit .env; keep it owner-only (chmod 600).
# One NAME=VALUE per line: the scenarios parse this file and never execute it.
#
# OpenRouter key for every live scenario (auto-detected from
# ~/.pi/agent/auth.json when absent). Get one from https://openrouter.ai
OPENROUTER_API_KEY=sk-or-v1-your-key-here
#
# Claude Code token for test/e2e/13_claude_code_plugin.sh only. Create it with
# `claude setup-token` in a separate terminal (it prints the token).
# CLAUDE_CODE_OAUTH_TOKEN=
