{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "intelli-v1/accounting@1",
  "type": "object",
  "required": [
    "schema",
    "schemaVersion",
    "namespaceId",
    "runId",
    "manifestSha256",
    "coverage",
    "attempts",
    "summary"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "intelli-v1/accounting"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "namespaceId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "runId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"
    },
    "manifestSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "coverage": {
      "type": "string",
      "const": "all-model-work-settled"
    },
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {},
        "additionalProperties": true
      }
    },
    "summary": {
      "type": "object",
      "properties": {},
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
