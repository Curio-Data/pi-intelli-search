+      // for the same provider/model stream and mark the attachment ambiguous.
+      id = lastIdByStream.get(streamKey) ?? null;
+      attachedWithoutId = true;
+    }
+    if (id === null) {
+      if (usageSource !== null) usageBearingObservations += 1; // counted, never claimed
