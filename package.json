{
  "name": "@curio-data/pi-intelli-search",
  "version": "0.16.0",
  "description": "Intelligent web research for Pi: search, extract, collate, and cache grounded web context in one tool call.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Curio-Data/pi-intelli-search.git"
  },
  "bugs": {
    "url": "https://github.com/Curio-Data/pi-intelli-search/issues"
  },
  "homepage": "https://github.com/Curio-Data/pi-intelli-search#readme",
  "type": "module",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "image": "https://raw.githubusercontent.com/Curio-Data/pi-intelli-search/main/docs/images/06.png"
  },
  "workspaces": [
    "packages/mcp"
  ],
  "scripts": {
    "build": "tsc",
    "build:mcp": "npm run build --workspace @curio-data/mcp-intelli-search",
    "typecheck:mcp": "npm run typecheck --workspace @curio-data/mcp-intelli-search",
    "test:mcp": "npm run test --workspace @curio-data/mcp-intelli-search",
    "test:mcp:install": "node scripts/verify-mcp-install.mjs",
    "generate:toc": "node scripts/generate-toc.mjs",
    "check:toc": "node scripts/generate-toc.mjs --check",
    "generate:plugins": "node scripts/generate-plugin-bundles.mjs",
    "check:plugins": "node scripts/generate-plugin-bundles.mjs --check",
    "generate:readmes": "node scripts/generate-package-readmes.mjs",
    "check:readmes": "node scripts/generate-package-readmes.mjs --check",
    "restore:readme": "node scripts/generate-package-readmes.mjs --restore-native",
    "build:all": "npm run build && npm run typecheck:mcp && npm run build:mcp",
    "test:all": "npm test && npm run test:mcp",
    "dev": "tsc --watch",
    "test": "node scripts/run-tests.mjs native",
    "test:smoke": "node scripts/run-tests.mjs smoke",
    "chart": "node scripts/plot-downloads.mts",
    "prepublishOnly": "node scripts/generate-package-readmes.mjs --publish-native"
  },
  "dependencies": {
    "defuddle": "^0.19.4",
    "linkedom": "^0.18.12",
    "wreq-js": "^2.3.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.0.4",
    "@earendil-works/pi-coding-agent": "^1.0.4",
    "@earendil-works/pi-tui": "^1.0.4",
    "esbuild": "0.28.2",
    "prettier": "^3.9.6",
    "roughjs": "^4.6.6",
    "tsx": "^4.19.0",
    "typebox": "*",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.81.1",
    "@earendil-works/pi-coding-agent": ">=0.81.1",
    "@earendil-works/pi-tui": ">=0.80.8",
    "typebox": "*"
  },
  "files": [
    "src/",
    "skills/",
    "dist/",
    "!dist/.tmp",
    "CHANGELOG.md",
    "NOTICE",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "pi-package",
    "pi-extension",
    "web-research",
    "web-search",
    "intelli-search"
  ]
}
